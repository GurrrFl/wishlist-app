@startuml
title Wishlist App - Class Diagram

' Domain models
class User {
  +user_id: Integer
  +login: String
  +password_hash: Text
  +email: String
  +created_at: String
}

class Wishlist {
  +wishlist_id: Integer
  +user_id: Integer
  +name: String
  +event_date: String
  +is_private: Integer
  +unique_link: String
  +created_at: String
}

class Gift {
  +gift_id: Integer
  +wishlist_id: Integer
  +name: String
  +description: Text
  +price: Float
  +store_link: String
  +status: String
  +created_at: String
}

class Reservation {
  +reservation_id: Integer
  +user_id: Integer
  +gift_id: Integer
  +reserved_date: String
  +cancelled_at: String
}

' Repository classes
class UserRepository
class WishlistRepository
class GiftRepository
class ReservationRepository

' Relationships
User "1" -- "0..*" Wishlist : owns >
Wishlist "1" -- "0..*" Gift : contains >
Gift "1" -- "0..*" Reservation : has >
User "1" -- "0..*" Reservation : makes >

' Repositories depend on models
UserRepository ..> User
WishlistRepository ..> Wishlist
GiftRepository ..> Gift
ReservationRepository ..> Reservation

@enduml
